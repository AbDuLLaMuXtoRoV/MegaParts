DATABASE_URL=postgresql+psycopg://megaparts:megaparts@localhost:5432/megaparts
API_PREFIX=/api/v1
PILOT_MODE=true
SEARCH_DEBUG=false
OFFER_FRESH_HOURS=2
OFFER_RECENT_HOURS=24
PREFERRED_SUPPLIER_IDS=
# Admin login. Admin pages stay locked until ADMIN_PASSWORD is set.
ADMIN_USERNAME=irizon
ADMIN_PASSWORD=
# Long random string; keeps admins signed in across restarts.
SESSION_SECRET=
# true when served over HTTPS
SECURE_COOKIES=false
